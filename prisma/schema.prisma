generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ------------------------------------------
// Enum 정의
// ------------------------------------------

enum Role {
    ADMIN // 어드민 권한
    USER // 일반 유저 권한
}

enum Grade {
    GENERAL // 일반 등급 (기본값)
    EXPERT // 전문가 등급 (참여/추천 조건 충족 시)
}

enum ChallengeStatus {
    PENDING // 승인 대기 중
    APPROVED // 승인됨 
    REJECTED // 거절됨
    DELETED // 삭제됨
    CLOSED // 마감됨
}

enum ParticipationStatus {
    ACTIVE // 참여 중 
    DROPPED // 포기함
    REMOVED // 어드민에 의해 삭제된 작업물의 1:1 참가이력
}

enum NotificationTargetType {
    CHALLENGE
    SUBMISSION
    FEEDBACK
}

enum NotificationType {
    CONTENT_CHANGED // 신청한 챌린지의 작업물/챌린지명/피드백 수정·삭제 알림
    STATUS_CHANGED // 신청한 챌린지 승인/거절/삭제 알림
    NEW_SUBMISSION // 신청한 챌린지에 새 작업물 등록 알림
    NEW_FEEDBACK // 도전한 작업물에 새 피드백 등록 알림
    DEADLINE // 신청한 챌린지 마감 알림
}

enum Field {
    NEXTJS // Next.js
    REACT // React
    MODERNJS // Modern JS
    TYPESCRIPT // TypeScript
    API // API
    WEB // Web
    CAREER // Career
}

enum DocType {
    OFFICIAL // 공식문서
    BLOG // 블로그
    BOOK // 도서
    ETC // 기타
}

// ------------------------------------------
// User - 회원 정보
// ------------------------------------------
model User {
    id            Int     @id @default(autoincrement())
    email         String  @unique // 로그인 식별자
    nickname      String // 참여 현황, 피드백 등에 노출되는 이름
    password      String // 해시된 비밀번호  // google OAuth 사용시 String? 으로 null able 
    role          Role    @default(USER) // 어드민/일반 유저 권한 분기
    grade         Grade   @default(GENERAL) // 등급 
    topLikedCount Int     @default(0) // 추천 선정 횟수 캐시
    refreshToken  String? // 해시 필수

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    challenges     Challenge[] // 내가 신청한 챌린지들
    participations Participation[] // 내가 참여한 이력
    feedbacks      Feedback[] // 내가 남긴 피드백
    likes          Like[] // 내가 남긴 좋아요
    notifications  Notification[] // 나에게 온 알림
    drafts         Draft[] // 내가 작성한 작업물 임시저장
    submissions    Submission[] // 내가 작성한 작업물
}

// ------------------------------------------
// Challenge - 챌린지
// ------------------------------------------
model Challenge {
    id                  Int             @id @default(autoincrement())
    title               String // 제목
    field               Field // 분야 - 필터링 대상
    docType             DocType // 문서타입 - 필터링 대상
    content             String
    originalUrl         String // 원문 링크 
    deadline            DateTime // 마감일
    maxParticipants     Int // 최대 참여 가능 인원
    currentParticipants Int             @default(0) // 현재 참여 인원 캐시 - Participation 생성/상태변경 시 갱신
    status              ChallengeStatus @default(PENDING) // 챌린지의 현재 상태
    reason              String? // 거절 사유
    deletedAt           DateTime? // updatedAt으로 대체 가능하긴 하지만 명시적으로 사용

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user           User            @relation(fields: [userId], references: [id])
    userId         Int // 신청자 id 
    participations Participation[] // 이 챌린지에 참여한 유저들의 참여 이력
    submissions    Submission[]

    @@index([status, deadline]) // status 단일로도 자주 사용됨(챌린지 목록) 복합인덱스의 경우 크론에서 사용 // 복합인덱스는 왼쪽부터 조회시작이기에 status 단일에도 활용됨
    @@index([userId]) // 특정 유저가 신청한 챌린지 조회 최적화
}

// ------------------------------------------
// Participation - 챌린지 참여
// ------------------------------------------
model Participation {
    id     Int                 @id @default(autoincrement())
    status ParticipationStatus @default(ACTIVE) // 참여중/포기/삭제됨

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt // 상태 변경(포기 등) 시각 추적

    user        User        @relation(fields: [userId], references: [id]) // 참여자
    userId      Int
    challenge   Challenge   @relation(fields: [challengeId], references: [id]) // 어느 챌린지에 참여한 건지
    challengeId Int
    submission  Submission? // 동시생성 로직이어도 실제로는 순차 생성이기 때문에 1:1 에서 필수값으로 정의할 수 없음
    //  생성 절차상 participation이 먼저 생성되기 때문에 FK를 submission이 가져야함

    @@unique([userId, challengeId]) // 한 유저가 같은 챌린지에 중복 참여하지 못하도록 하는 제약
    @@index([challengeId]) // 챌린지별 참여자 목록 조회 최적화
}

// ------------------------------------------
// Submission - 번역 작업물
// content는 "제출하기"를 눌렀을 때만 값이 채워짐. 작성 중인 내용은 Draft에서 별도로 관리
// ------------------------------------------
model Submission {
    id              Int       @id @default(autoincrement())
    content         String    @default("") // 제출된 최종 내용 - 제출 전에는 빈 값 유지
    deletedAt       DateTime? // soft delete
    isTopSubmission Boolean   @default(false) // 최대 추천작 여부 - 챌린지 마감 시점에 배치로 한 번만 계산(동점이면 여러 건 true 가능)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    participation   Participation @relation(fields: [participationId], references: [id])
    participationId Int           @unique
    challenge       Challenge     @relation(fields: [challengeId], references: [id])
    challengeId     Int
    user            User          @relation(fields: [userId], references: [id])
    userId          Int
    draft           Draft? // 작성 중인 초안 (제출 전 자동 백업용, 30초 주기 동기화 - LocalStorage가 메인이고 정전 등 유실 대비)
    feedbacks       Feedback[] // 이 작업물에 달린 피드백들
    likes           Like[] // 이 작업물이 받은 좋아요들

    @@index([deletedAt]) // soft delete 필터링 조회 최적화 
}

// ------------------------------------------
// Draft - 작성 중인 초안 (제출 전 자동 백업)
// LocalStorage가 메인이고, 30초 주기로 이곳에 동기화되어 정전 등 유실 상황 대비
// ------------------------------------------
model Draft {
    id      Int     @id @default(autoincrement())
    title   String? // 임시저장물의 제목 / 사용자가 미입력시 프론트에서 '제목없음'으로 처리
    content String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt // 마지막 자동 백업 시각

    submission   Submission @relation(fields: [submissionId], references: [id])
    submissionId Int        @unique
    user         User       @relation(fields: [userId], references: [id])
    userId       Int
}

// ------------------------------------------
// Feedback - 번역 작업물에 대한 피드백
// ------------------------------------------
model Feedback {
    id      Int    @id @default(autoincrement())
    content String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt // 피드백 수정 시각 

    submissionId Int
    submission   Submission @relation(fields: [submissionId], references: [id]) // 어느 작업물에 대한 피드백인지
    userId       Int
    user         User       @relation(fields: [userId], references: [id]) // 피드백 작성자

    @@index([submissionId]) // 작업물별 피드백 목록 조회 최적화
}

// ------------------------------------------
// Like - 번역 작업물 추천(좋아요)
// ------------------------------------------
model Like {
    id Int @id @default(autoincrement())

    createdAt DateTime @default(now())

    user         User       @relation(fields: [userId], references: [id]) // 좋아요를 누른 유저
    userId       Int
    submission   Submission @relation(fields: [submissionId], references: [id]) // 좋아요를 받은 작업물
    submissionId Int

    @@unique([userId, submissionId]) // 한 유저가 같은 작업물에 중복으로 좋아요를 못 누르게 하는 제약
    @@index([submissionId]) //좋아요 개수 집계가 크론(마감 시점 1등 계산)과 작업물 상세 페이지 양쪽에서 실제로 쓰이는 조회라 추가할 가치가 있음
}

// ------------------------------------------
// Notification - 알림
// ------------------------------------------
model Notification {
    id         Int                    @id @default(autoincrement())
    type       NotificationType // 알림 종류 
    targetType NotificationTargetType // 알람이 발생한 곳이 어느 테이블인지 명시
    targetId   Int // 관련 레코드 id 
    message    String // 알림 내용 텍스트
    isRead     Boolean                @default(false) // 읽음 처리 여부

    createdAt DateTime @default(now())

    user   User @relation(fields: [userId], references: [id]) // 알림 수신 대상
    userId Int

    @@index([userId, isRead]) // 유저별 알림 목록 조회 최적화
    @@index([targetType, targetId]) // 특정 대상에 대한 알림 조회 최적화
}
