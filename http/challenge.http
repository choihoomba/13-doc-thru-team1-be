@BASE_URL = http://localhost:4000
@APPROVED_CHALLENGE_ID = 12

# Challenge API 수동 테스트 파일입니다.
# npm run seed 실행 후 위에서부터 필요한 요청을 선택하여 실행합니다.
# REST Client는 로그인 응답의 HttpOnly 쿠키를 다음 요청에 자동으로 전달합니다.

### 1. 일반 사용자 로그인
POST {{BASE_URL}}/auth/signin
Content-Type: application/json

{
  "email": "jihoon@docsru.dev",
  "password": "test1234!"
}

### 2. 신규 챌린지 신청 - 201
POST {{BASE_URL}}/challenges
Content-Type: application/json

{
  "title": "Express Router 공식 문서 번역",
  "field": "WEB",
  "docType": "OFFICIAL",
  "content": "Express Router 공식 문서를 함께 번역합니다.",
  "originalUrl": "https://expressjs.com/en/guide/routing.html",
  "deadline": "2026-12-20T23:59:59.000Z",
  "maxParticipants": 8
}

### 3. 생성 검증 실패 - 지난 마감일, 400
POST {{BASE_URL}}/challenges
Content-Type: application/json

{
  "title": "마감일 검증 테스트",
  "field": "WEB",
  "docType": "OFFICIAL",
  "content": "지난 마감일은 허용하지 않습니다.",
  "originalUrl": "https://example.com/docs",
  "deadline": "2025-01-01",
  "maxParticipants": 5
}

### 4. 일반 사용자의 관리자 수정 요청 - 403
PATCH {{BASE_URL}}/challenges/{{APPROVED_CHALLENGE_ID}}
Content-Type: application/json

{
  "maxParticipants": 6
}

### 5. 관리자 로그인
POST {{BASE_URL}}/auth/signin
Content-Type: application/json

{
  "email": "admin@docsru.dev",
  "password": "test1234!"
}

### 6. 진행 중인 챌린지 수정 - 200
# seed 데이터 기준 ID 12는 APPROVED 상태이며 기존 maxParticipants 값도 6입니다.
PATCH {{BASE_URL}}/challenges/{{APPROVED_CHALLENGE_ID}}
Content-Type: application/json

{
  "maxParticipants": 6
}

### 7. 빈 수정 요청 - 400
PATCH {{BASE_URL}}/challenges/{{APPROVED_CHALLENGE_ID}}
Content-Type: application/json

{}

### 8. 존재하지 않는 챌린지 수정 - 404
PATCH {{BASE_URL}}/challenges/999999
Content-Type: application/json

{
  "title": "존재하지 않는 챌린지"
}

### 9. 관리자의 신규 챌린지 신청 - 201
POST {{BASE_URL}}/challenges
Content-Type: application/json

{
  "title": "관리자 신청 권한 테스트",
  "field": "API",
  "docType": "ETC",
  "content": "USER와 ADMIN 모두 신규 챌린지를 신청할 수 있습니다.",
  "originalUrl": "https://example.com/admin",
  "deadline": "2026-12-31T23:59:59.000Z",
  "maxParticipants": 5
}
