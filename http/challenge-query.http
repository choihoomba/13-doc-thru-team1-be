@BASE_URL = http://localhost:4000

# seed 계정 (README 기준) — 비밀번호는 전부 test1234!
# admin@docsru.dev  (ADMIN)
# jihoon@docsru.dev (USER / GENERAL)
# react@docsru.dev  (USER / EXPERT)
# docs@docsru.dev   (USER / EXPERT)

# ============================================================
# [정상 흐름] 위에서부터 순서대로 실행하세요.
# REST Client가 signin 쿠키를 자동으로 이후 요청에 실어줍니다.
# (자동 전송 안 되면 설정에서 rest-client.rememberCookiesForSubscribeRequests = true)
# ============================================================


### 1. signin — 로그인 (쿠키 발급)
POST {{BASE_URL}}/auth/signin
Content-Type: application/json

{
  "email": "admin@docsru.dev",
  "password": "test1234!"
}

### 2. me — 본인 정보 조회 (쿠키 인증)
GET {{BASE_URL}}/auth/me

### 3. refresh — 토큰 재발급 (쿠키 갱신 + DB 해시 회전)
### DBeaver로 해당 유저 refreshToken 값이 전후로 바뀌는지 확인
POST {{BASE_URL}}/auth/refresh

### 4. me — refresh 후에도 정상 조회되는지
GET {{BASE_URL}}/auth/me

### 5. signout — 로그아웃 (쿠키 삭제 + DB refreshToken null)
POST {{BASE_URL}}/auth/signout


# ============================================================
# 1. 일반 사용자 로그인
# ============================================================

### 일반 사용자 로그인
# 기대 결과:
# - 200 OK
# - accessToken, refreshToken 쿠키 발급
POST {{BASE_URL}}/auth/signin
Content-Type: application/json

{
  "email": "jihoon@docsru.dev",
  "password": "test1234!"
}

# ============================================================
# 2. 전체 공개 챌린지 목록
# ============================================================

### 공개 챌린지 목록 — view 생략
# view의 기본값이 public이므로 공개 목록을 반환해야 합니다.
#
# 기대 결과:
# - 200 OK
# - APPROVED 또는 CLOSED 상태만 조회
# - deletedAt이 있는 데이터 제외
# - 기본 정렬 latest
# - 기본 page=1
# - 기본 limit=10
GET {{BASE_URL}}/challenges


### 공개 챌린지 목록 — view 명시
# 기대 결과:
# - 200 OK
# - GET /challenges와 동일한 조회 조건
GET {{BASE_URL}}/challenges?view=public


### 공개 챌린지 목록 — 페이지네이션
# 기대 결과:
# - 200 OK
# - pagination.page = 1
# - pagination.limit = 5
GET {{BASE_URL}}/challenges?view=public&page=1&limit=5


### 공개 챌린지 목록 — 두 번째 페이지
# 기대 결과:
# - 200 OK
# - 첫 번째 페이지 다음 데이터 조회
GET {{BASE_URL}}/challenges?view=public&page=2&limit=5


### 공개 챌린지 목록 — 제목 검색
# title에 router가 포함된 챌린지를 조회합니다.
#
# 기대 결과:
# - 200 OK
# - 영문 대소문자를 구분하지 않고 검색
GET {{BASE_URL}}/challenges?view=public&search=router


### 공개 챌린지 목록 — 한글 제목 검색
# 기대 결과:
# - 200 OK
# - 제목에 "리액트"가 포함된 챌린지 조회
GET {{BASE_URL}}/challenges?view=public&search=리액트


### 공개 챌린지 목록 — 분야 필터
# 기대 결과:
# - 200 OK
# - field가 REACT인 챌린지만 조회
GET {{BASE_URL}}/challenges?view=public&field=REACT


### 공개 챌린지 목록 — 문서 유형 필터
# 기대 결과:
# - 200 OK
# - docType이 OFFICIAL인 챌린지만 조회
GET {{BASE_URL}}/challenges?view=public&docType=OFFICIAL


### 공개 챌린지 목록 — 진행 중 상태
# 공개 목록에서는 APPROVED와 CLOSED만 status로 사용할 수 있습니다.
#
# 기대 결과:
# - 200 OK
# - APPROVED 상태만 조회
GET {{BASE_URL}}/challenges?view=public&status=APPROVED


### 공개 챌린지 목록 — 완료 상태
# 기대 결과:
# - 200 OK
# - CLOSED 상태만 조회
GET {{BASE_URL}}/challenges?view=public&status=CLOSED


### 공개 챌린지 목록 — 복합 검색 및 필터
# 기대 결과:
# - 200 OK
# - 모든 조건을 동시에 만족하는 데이터만 조회
GET {{BASE_URL}}/challenges?view=public&search=react&field=REACT&docType=OFFICIAL&status=APPROVED&page=1&limit=10


# ============================================================
# 3. 공개 목록 정렬
# ============================================================

### 공개 챌린지 목록 — 최신 등록 순
# createdAt 내림차순
GET {{BASE_URL}}/challenges?view=public&sort=latest


### 공개 챌린지 목록 — 오래된 등록 순
# createdAt 오름차순
GET {{BASE_URL}}/challenges?view=public&sort=oldest


### 공개 챌린지 목록 — 마감일 빠른 순
# deadline 오름차순
GET {{BASE_URL}}/challenges?view=public&sort=deadlineAsc


### 공개 챌린지 목록 — 마감일 늦은 순
# deadline 내림차순
GET {{BASE_URL}}/challenges?view=public&sort=deadlineDesc


# ============================================================
# 4. 내가 참여 중인 챌린지 목록
# ============================================================

### 참여 중인 챌린지 — 기본 조회
# 조회 조건:
#
# - 로그인 사용자의 ACTIVE 참여 기록 존재
# - Challenge.status = APPROVED
# - Challenge.deadline > 현재 시각
# - Challenge.deletedAt = null
#
# 기대 결과:
# - 200 OK
# - participations에 현재 사용자의 참여 기록 포함
# - participation.submission에 작업물 ID 포함
GET {{BASE_URL}}/challenges?view=participating


### 참여 중인 챌린지 — 제목 검색
# 기대 결과:
# - 200 OK
# - 참여 중인 챌린지 중 title에 api가 포함된 데이터 조회
GET {{BASE_URL}}/challenges?view=participating&search=api


### 참여 중인 챌린지 — 분야 필터
# 기대 결과:
# - 200 OK
# - 참여 중인 챌린지 중 WEB 분야만 조회
GET {{BASE_URL}}/challenges?view=participating&field=WEB


### 참여 중인 챌린지 — 문서 유형 필터
# 기대 결과:
# - 200 OK
# - 참여 중인 챌린지 중 공식 문서만 조회
GET {{BASE_URL}}/challenges?view=participating&docType=OFFICIAL


### 참여 중인 챌린지 — 복합 조건
# 기대 결과:
# - 200 OK
# - 검색·분야·문서 유형 조건을 모두 만족하는 데이터 조회
GET {{BASE_URL}}/challenges?view=participating&search=react&field=REACT&docType=OFFICIAL&page=1&limit=5


### 참여 중인 챌린지 — 두 번째 페이지
# 프론트 무한 스크롤에서는 page를 증가시키며 요청할 수 있습니다.
#
# 기대 결과:
# - 200 OK
# - pagination.page = 2
GET {{BASE_URL}}/challenges?view=participating&page=2&limit=5


### 참여 중인 챌린지 — 검색 결과 없음
# 기대 결과:
# - 200 OK
# - data.challenges = []
# - pagination.total = 0
# - pagination.totalPages = 0
GET {{BASE_URL}}/challenges?view=participating&search=존재하지않는챌린지99999


# ============================================================
# 5. 내가 완료한 챌린지 목록
# ============================================================

### 완료한 챌린지 — 기본 조회
# 조회 조건:
#
# - 로그인 사용자의 ACTIVE 참여 기록 존재
# - Challenge.deletedAt = null
# - Challenge.status가 CLOSED이거나 deadline이 현재 시각 이하
#
# 기대 결과:
# - 200 OK
# - CLOSED 챌린지 포함
# - 상태가 APPROVED여도 마감일이 지났다면 포함
GET {{BASE_URL}}/challenges?view=completed


### 완료한 챌린지 — 제목 검색
# 기대 결과:
# - 200 OK
# - 완료한 챌린지 중 제목 검색
GET {{BASE_URL}}/challenges?view=completed&search=react


### 완료한 챌린지 — 분야 필터
# 기대 결과:
# - 200 OK
# - 완료한 챌린지 중 REACT 분야만 조회
GET {{BASE_URL}}/challenges?view=completed&field=REACT


### 완료한 챌린지 — 문서 유형 필터
# 기대 결과:
# - 200 OK
# - 완료한 챌린지 중 BLOG 문서 유형만 조회
GET {{BASE_URL}}/challenges?view=completed&docType=BLOG


### 완료한 챌린지 — 복합 조건
# 기대 결과:
# - 200 OK
GET {{BASE_URL}}/challenges?view=completed&search=javascript&field=MODERNJS&docType=OFFICIAL&page=1&limit=5


### 완료한 챌린지 — 오래된 등록 순
# 기대 결과:
# - 200 OK
# - createdAt 오름차순
GET {{BASE_URL}}/challenges?view=completed&sort=oldest


### 완료한 챌린지 — 검색 결과 없음
# 기대 결과:
# - 200 OK
# - data.challenges = []
# - pagination.total = 0
GET {{BASE_URL}}/challenges?view=completed&search=존재하지않는챌린지99999


# ============================================================
# 6. 일반 사용자의 관리자 목록 접근
# ============================================================

### 일반 사용자가 관리자 목록 요청
# 현재 jihoon 계정으로 로그인된 상태에서 실행합니다.
#
# 기대 결과:
# - 403 FORBIDDEN
#
# 예상 에러 응답:
#
# {
#   "success": false,
#   "message": "관리자 챌린지 신청 목록은 관리자만 조회할 수 있습니다.",
#   "code": "FORBIDDEN"
# }
GET {{BASE_URL}}/challenges?view=admin


# ============================================================
# 7. 관리자 로그인
# ============================================================

### 관리자 로그인
# 기대 결과:
# - 200 OK
# - 기존 USER 쿠키가 ADMIN 계정 쿠키로 변경


# ============================================================
# 8. 관리자 챌린지 신청 관리 목록
# ============================================================

### 관리자 신청 관리 — 기본 조회
# status를 생략하면 Service에서 PENDING을 기본값으로 사용합니다.
#
# 기대 결과:
# - 200 OK
# - PENDING 상태만 조회
# - user에 신청자 id, nickname, email 포함
GET {{BASE_URL}}/challenges?view=admin


### 관리자 신청 관리 — 페이지네이션
# 기대 결과:
# - 200 OK
# - pagination.page = 1
# - pagination.limit = 5
GET {{BASE_URL}}/challenges?view=admin&page=1&limit=5


### 관리자 신청 관리 — 제목 검색
# 기대 결과:
# - 200 OK
# - PENDING 신청 중 제목에 리액트가 포함된 데이터 조회
GET {{BASE_URL}}/challenges?view=admin&search=리액트


### 관리자 신청 관리 — 분야 필터
# 기대 결과:
# - 200 OK
GET {{BASE_URL}}/challenges?view=admin&field=WEB


### 관리자 신청 관리 — 문서 유형 필터
# 기대 결과:
# - 200 OK
GET {{BASE_URL}}/challenges?view=admin&docType=OFFICIAL


### 관리자 신청 관리 — 승인 대기
# 기대 결과:
# - 200 OK
# - PENDING 상태만 조회
GET {{BASE_URL}}/challenges?view=admin&status=PENDING


### 관리자 신청 관리 — 승인 완료
# 기대 결과:
# - 200 OK
# - APPROVED 상태만 조회
GET {{BASE_URL}}/challenges?view=admin&status=APPROVED


### 관리자 신청 관리 — 승인 거절
# 기대 결과:
# - 200 OK
# - REJECTED 상태만 조회
GET {{BASE_URL}}/challenges?view=admin&status=REJECTED


### 관리자 신청 관리 — 삭제됨
# 기대 결과:
# - 200 OK
# - DELETED 상태만 조회
GET {{BASE_URL}}/challenges?view=admin&status=DELETED


### 관리자 신청 관리 — 마감됨
# 기대 결과:
# - 200 OK
# - CLOSED 상태만 조회
GET {{BASE_URL}}/challenges?view=admin&status=CLOSED


### 관리자 신청 관리 — 최신 신청 순
# 기대 결과:
# - 200 OK
# - createdAt 내림차순
GET {{BASE_URL}}/challenges?view=admin&status=PENDING&sort=latest


### 관리자 신청 관리 — 오래된 신청 순
# 기대 결과:
# - 200 OK
# - createdAt 오름차순
GET {{BASE_URL}}/challenges?view=admin&status=PENDING&sort=oldest


### 관리자 신청 관리 — 마감일 빠른 순
# 기대 결과:
# - 200 OK
# - deadline 오름차순
GET {{BASE_URL}}/challenges?view=admin&status=PENDING&sort=deadlineAsc


### 관리자 신청 관리 — 마감일 늦은 순
# 기대 결과:
# - 200 OK
# - deadline 내림차순
GET {{BASE_URL}}/challenges?view=admin&status=PENDING&sort=deadlineDesc


### 관리자 신청 관리 — 복합 검색·필터·정렬
# 기대 결과:
# - 200 OK
GET {{BASE_URL}}/challenges?view=admin&search=express&field=WEB&docType=OFFICIAL&status=PENDING&sort=oldest&page=1&limit=10


# ============================================================
# 9. Validation 에러 테스트
# ============================================================

### 지원하지 않는 view
# applied는 이번 구현 범위에 포함되지 않습니다.
#
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=applied


### 존재하지 않는 view
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=myChallenges


### 공개 목록에서 PENDING 요청
# public은 APPROVED 또는 CLOSED만 허용합니다.
#
# 기대 결과:
# - 400 VALIDATION_ERROR
#
# 예상 메시지:
# 공개 목록의 status는 APPROVED 또는 CLOSED만 사용할 수 있습니다.
GET {{BASE_URL}}/challenges?view=public&status=PENDING


### 공개 목록에서 REJECTED 요청
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=public&status=REJECTED


### 공개 목록에서 DELETED 요청
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=public&status=DELETED


### 참여 중 목록에 status 전달
# participating 상태는 Service가 직접 결정합니다.
#
# 기대 결과:
# - 400 VALIDATION_ERROR
#
# 예상 메시지:
# 참여 중/완료 목록에서는 status를 함께 사용할 수 없습니다.
GET {{BASE_URL}}/challenges?view=participating&status=APPROVED


### 완료 목록에 status 전달
# completed 상태는 Service가 직접 결정합니다.
#
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=completed&status=CLOSED


### 지원하지 않는 field
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=public&field=SPRING


### 지원하지 않는 docType
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=public&docType=YOUTUBE


### 지원하지 않는 status
# ACTIVE는 ParticipationStatus이며 ChallengeStatus가 아닙니다.
#
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=admin&status=ACTIVE


### 지원하지 않는 sort
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=public&sort=popular


### page가 숫자가 아님
# 기대 결과:
# - 400 VALIDATION_ERROR
GET {{BASE_URL}}/challenges?view=public&page=abc


# ============================================================
# 10. 인증 에러 테스트
# ============================================================

### 비로그인 공개 목록 요청
# 이 테스트 전 REST Client의 저장된 쿠키를 삭제해야 합니다.
#
# 프로젝트 요구사항상 모든 챌린지 목록은 로그인이 필요합니다.
#
# 기대 결과:
# - 401 UNAUTHORIZED
#
# 예상 응답:
#
# {
#   "success": false,
#   "message": "로그인이 필요합니다.",
#   "code": "UNAUTHORIZED"
# }
GET {{BASE_URL}}/challenges?view=public


### 비로그인 참여 중 목록 요청
# 이 테스트 전 REST Client의 저장된 쿠키를 삭제해야 합니다.
#
# 기대 결과:
# - 401 UNAUTHORIZED
GET {{BASE_URL}}/challenges?view=participating


### 비로그인 완료 목록 요청
# 이 테스트 전 REST Client의 저장된 쿠키를 삭제해야 합니다.
#
# 기대 결과:
# - 401 UNAUTHORIZED
GET {{BASE_URL}}/challenges?view=completed


### 비로그인 관리자 목록 요청
# 이 테스트 전 REST Client의 저장된 쿠키를 삭제해야 합니다.
#
# 인증 검사가 권한 검사보다 먼저 실행되므로 403이 아니라 401입니다.
#
# 기대 결과:
# - 401 UNAUTHORIZED
GET {{BASE_URL}}/challenges?view=admin