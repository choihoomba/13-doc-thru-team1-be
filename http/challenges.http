@BASE_URL = http://localhost:4000

# seed 계정 (README 기준) — 비밀번호는 전부 test1234!
# admin@docsru.dev  (ADMIN)
# jihoon@docsru.dev (USER / GENERAL)
# react@docsru.dev  (USER / EXPERT)
# docs@docsru.dev   (USER / EXPERT)

# ============================================================
# [정상 흐름] 위에서부터 순서대로 실행하세요.
# REST Client가 signin 쿠키를 자동으로 이후 요청에 실어줍니다.
# (자동 전송 안 되면 설정에서 rest-client.rememberCookiesForSubscribeRequests = true)
# ============================================================


### 1. signin — 로그인 (쿠키 발급)
POST {{BASE_URL}}/auth/signin
Content-Type: application/json

{
  "email": "admin@docsru.dev",
  "password": "test1234!"
}

### 2. me — 본인 정보 조회 (쿠키 인증)
GET {{BASE_URL}}/auth/me

### 3. refresh — 토큰 재발급 (쿠키 갱신 + DB 해시 회전)
### DBeaver로 해당 유저 refreshToken 값이 전후로 바뀌는지 확인
POST {{BASE_URL}}/auth/refresh

### 4. me — refresh 후에도 정상 조회되는지
GET {{BASE_URL}}/auth/me

# ============================================================
  # 챌린지 목록 조회 확인 (필터, 페이지네이션, 검색)
  # 일반 등급, 전문가 등급 조회 확인
  # 어드민 챌린지 조회 확인
# ============================================================

### 챌린지 목록 조회 (기본 정렬 최신순)
GET {{BASE_URL}}/challenges

### 챌린지 목록 조회 (1페이지)
GET {{BASE_URL}}/challenges?page=1&pageSize=5

### 챌린지 목록 조회 (2페이지)
GET {{BASE_URL}}/challenges?page=2&pageSize=5

### 챌린지 필터 조회 (React 챌린지)
GET {{BASE_URL}}/challenges?field=REACT

### 챌린지 필터 조회 (공식문서)
GET {{BASE_URL}}/challenges?docType=OFFICIAL

### 챌린지 필터 조회 (참여중인 챌린지)
GET {{BASE_URL}}/challenges?status=APPROVED

### 챌린지 필터 조회 조건 2개 (React + 공식문서)
GET {{BASE_URL}}/challenges?field=REACT&docType=OFFICIAL

### 챌린지 필터 조회 (API + 공식문서 + 진행중)
GET {{BASE_URL}}/challenges?field=API&docType=OFFICIAL&status=APPROVED

### 챌린지 검색 조회 (React 검색)
GET {{BASE_URL}}/challenges?search=React

### 9. 챌린지 목록 조회 — 검색, 필터
GET {{BASE_URL}}/challenges?page=1&pageSize=5&keyword=리액트&field=REACT


# ============================================================
   #챌린지 목록 에러 케이스
# ============================================================


### page 숫자가 아님 (400 VALIDATION_ERROR)
GET {{BASE_URL}}/challenges?page=abc

### page=0 (400 VALIDATION_ERROR)
GET {{BASE_URL}}/challenges?page=0

### 조회 — pageSize가 허용 범위를 초과 (400 VALIDATION_ERROR)
GET {{BASE_URL}}/challenges?pageSize=101

### 잘못된 field (400 VALIDATION_ERROR)
GET {{BASE_URL}}/challenges?field=SPRING

### 잘못된 status (400 VALIDATION_ERROR)
GET {{BASE_URL}}/challenges?status=SUCCESS

### 잘못된 docType (400 VALIDATION_ERROR)
GET {{BASE_URL}}/challenges?docType=YOUTUBE

### 결과 없음 (200 success=true data=[] totalCount=0 검색은 했으나 결과값은 없음)
GET {{BASE_URL}}/challenges?field=WEB&docType=OFFICIAL&status=CLOSED

### 로그인 안 된 상태 (401 로그인이 필요합니다. UNAUTHORIZED)
GET {{BASE_URL}}/challenges 