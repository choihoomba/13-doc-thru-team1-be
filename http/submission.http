@baseUrl = http://localhost:4000

# 모든 엔드포인트가 회원 인증이 필요합니다. 로그인 응답에서 받은 accessToken 쿠키 값을 넣어주세요.
@accessToken = REPLACE_WITH_REAL_ACCESS_TOKEN

### 작업물 목록 조회 (기본 정렬)
GET {{baseUrl}}/submissions
# Cookie: accessToken={{accessToken}}

### 작업물 목록 조회 (특정 챌린지 필터)
GET {{baseUrl}}/submissions?challengeId=1
Cookie: accessToken={{accessToken}}

### 작업물 목록 조회 (좋아요순 정렬)
GET {{baseUrl}}/submissions?challengeId=1&orderBy=likeDesc
Cookie: accessToken={{accessToken}}

### 작업물 목록 조회 (작성자 정보 포함)
GET {{baseUrl}}/submissions?include=user
Cookie: accessToken={{accessToken}}

### 작업물 목록 조회 (임시저장 초안 포함)
GET {{baseUrl}}/submissions?include=draft
Cookie: accessToken={{accessToken}}

### 작업물 상세 조회 (작업물만)
GET {{baseUrl}}/submissions/1
Cookie: accessToken={{accessToken}}

### 작업물 상세 조회 (피드백 포함)
GET {{baseUrl}}/submissions/1?include=feedback
Cookie: accessToken={{accessToken}}

### 존재하지 않는 작업물 조회 (404 확인용)
GET {{baseUrl}}/submissions/999999
Cookie: accessToken={{accessToken}}

### 작업물 생성 (제출하기)
# participationId는 본인이 ACTIVE 상태로 참여 중인 Participation의 id여야 합니다.
POST {{baseUrl}}/submissions
Content-Type: application/json
Cookie: accessToken={{accessToken}}

{
  "participationId": 1,
  "content": "번역한 내용을 여기에 작성합니다."
}

### 작업물 생성 - 유효성 검사 실패 (content 누락, 400 확인용)
POST {{baseUrl}}/submissions
Content-Type: application/json
Cookie: accessToken={{accessToken}}

{
  "participationId": 1
}

### 작업물 생성 - 이미 제출된 참여 내역 (409 확인용)
POST {{baseUrl}}/submissions
Content-Type: application/json
Cookie: accessToken={{accessToken}}

{
  "participationId": 1,
  "content": "같은 participationId로 두 번째 제출 시도"
}

### 작업물 수정
PATCH {{baseUrl}}/submissions/1
Content-Type: application/json
Cookie: accessToken={{accessToken}}

{
  "content": "수정된 내용입니다."
}

### 작업물 수정 - 본인 소유가 아닌 작업물 (403 확인용)
PATCH {{baseUrl}}/submissions/2
Content-Type: application/json
Cookie: accessToken={{accessToken}}

{
  "content": "다른 사람 작업물을 수정 시도"
}

### 작업물 삭제 (soft delete)
DELETE {{baseUrl}}/submissions/1
Cookie: accessToken={{accessToken}}

### 삭제된 작업물 재조회 (조회에서 제외되는지 확인용)
GET {{baseUrl}}/submissions/1
Cookie: accessToken={{accessToken}}
