PORT=4000
DATABASE_URL=
NODE_ENV=development # 실행 환경 구분(development|production). 쿠키 secure 옵션 등 환경별 분기에 사용
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m # 개발 중 테스트 편의로 조정 가능 / 형식: 숫자 + s/m/h/d
JWT_REFRESH_EXPIRES_IN=7d # 개발 중 테스트 편의로 조정 가능 / 형식: 숫자 + s/m/h/d
CLIENT_URL=http://localhost:3000